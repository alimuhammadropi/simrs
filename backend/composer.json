{
  "name": "simrs/backend",
  "description": "SIMRS outpatient Yii2 API",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "yiisoft/yii2": "^2.0.49",
    "yiisoft/yii2-symfonymailer": "^2.0",
    "firebase/php-jwt": "^6.10"
  },
  "require-dev": {
    "yiisoft/yii2-debug": "^2.1",
    "yiisoft/yii2-gii": "^2.2"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "process-timeout": 1800,
    "policy": {
      "advisories": {
        "ignore-id": {
          "PKSA-y2cr-5h3j-g3ys": "No patched firebase/php-jwt release available yet"
        }
      }
    }
  },
  "scripts": {
    "post-install-cmd": [
      "yii\\composer\\Installer::postInstall"
    ],
    "post-create-project-cmd": [
      "yii\\composer\\Installer::postCreateProject"
    ]
  }
}
