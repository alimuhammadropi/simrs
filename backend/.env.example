# Export these variables in your shell before starting Yii.
DB_DSN=pgsql:host=127.0.0.1;port=5432;dbname=simrs
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=simrs-api
JWT_TTL=3600
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://demo.mr-ali.my.id
REGISTRATION_FEE=25000
NODE_SERVICE_URL=http://127.0.0.1:3010
NODE_SERVICE_KEY=local-dev-service-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=/secure/path/firebase-service-account.json
FCM_TIMEOUT=10
