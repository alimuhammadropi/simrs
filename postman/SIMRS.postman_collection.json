    {
      "name": "11 Input hasil lab",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"result\":\"Hb 13 g/dL\",\"reference_range\":\"12-16\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/lab/requests/{{labRequestId}}/result",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "lab",
            "requests",
            "{{labRequestId}}",
            "result"
          ]
        }
      }
    },
    {
      "name": "11b Cek hasil lab di riwayat kunjungan",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/examinations/{{examId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "examinations",
            "{{examId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('hasil lab terbaca di detail pemeriksaan', function () {",
              "  var labs = pm.response.json().data.lab_requests || [];",
              "  pm.expect(labs.length).to.be.above(0);",
              "  pm.expect(labs[0].result).to.eql('Hb 13 g/dL');",
              "  pm.expect(labs[0].reference_range).to.eql('12-16');",
              "  pm.expect(labs[0].result_by).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Buka tagihan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"registration_id\":{{registrationId}}}"
        },
        "url": {
          "raw": "{{baseUrl}}/invoices",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "invoices"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('invoice dibuat', function () { pm.response.to.have.status(200); });",
              "var invoice = pm.response.json().data.invoice;",
              "pm.collectionVariables.set('invoiceId', invoice.id);",
              "pm.collectionVariables.set('amount', invoice.total);",
              "var total = Number(invoice.total);",
              "pm.collectionVariables.set('partialAmount', Math.max(0.01, Math.round((total - 15000) * 100) / 100));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Bayar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"amount\":{{partialAmount}},\"method\":\"cash\",\"idempotency_key\":\"{{payKey}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/invoices/{{invoiceId}}/pay",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "invoices",
            "{{invoiceId}}",
            "pay"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('payKey')) pm.collectionVariables.set('payKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('pembayaran sukses', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json().data;",
              "pm.collectionVariables.set('paymentId', data.payment.id);",
              "var remaining = Math.round((Number(data.invoice.total) - Number(data.invoice.paid_amount)) * 100) / 100;",
              "pm.collectionVariables.set('remainingBefore', remaining);",
              "pm.collectionVariables.set('overpayAmount', Math.round((remaining + 15000) * 100) / 100);"
            ]
          }
        }
      ]
    },
    {
      "name": "13b Bayar ulang (idempoten)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"amount\":{{partialAmount}},\"method\":\"cash\",\"idempotency_key\":\"{{payKey}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/invoices/{{invoiceId}}/pay",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "invoices",
            "{{invoiceId}}",
            "pay"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('idempotensi pembayaran', function () {",
              "  var data = pm.response.json().data;",
              "  pm.expect(data.replayed).to.eql(true);",
              "  pm.expect(data.payment.id).to.eql(Number(pm.collectionVariables.get('paymentId')));",
              "  pm.expect(Number(data.payment.amount)).to.eql(Number(pm.collectionVariables.get('partialAmount')));",
              "  pm.expect(Number(data.payment.change_amount)).to.eql(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13c Bayar lebih dari sisa (kembalian)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"amount\":{{overpayAmount}},\"method\":\"cash\",\"idempotency_key\":\"{{payKeyOverpay}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/invoices/{{invoiceId}}/pay",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "invoices",
            "{{invoiceId}}",
            "pay"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('payKeyOverpay')) pm.collectionVariables.set('payKeyOverpay', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('pembayaran lebih sukses', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json().data;",
              "pm.test('kembalian 15000', function () { pm.expect(Number(data.payment.change_amount)).to.eql(15000); });",
              "pm.test('nominal dipakai sesuai sisa', function () { pm.expect(Number(data.payment.amount)).to.eql(Number(pm.collectionVariables.get('remainingBefore'))); });",
              "pm.test('invoice lunas tanpa kelebihan paid_amount', function () {",
              "  pm.expect(data.invoice.status).to.eql('paid');",
              "  pm.expect(Number(data.invoice.paid_amount)).to.eql(Number(data.invoice.total));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Dashboard",
      "request": {
        "method": "GET",
        "auth": {
