{
  "info": {
    "name": "SIMRS Rawat Jalan",
    "description": "Koleksi endpoint demo untuk environment dev/demo (menulis data uji). Jalankan 01-22 berurutan lewat Collection Runner: token, NIK, tanggal, nominal, dan kunci idempotensi diisi otomatis. 04b/13b membuktikan idempotensi, 13c membuktikan kembalian saat bayar lebih, 11b memeriksa hasil lab di riwayat kunjungan, 19-22 menguji layanan Node.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8086/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    },
    {
      "key": "registrationId",
      "value": ""
    },
    {
      "key": "examId",
      "value": ""
    },
    {
      "key": "prescriptionId",
      "value": ""
    },
    {
      "key": "labRequestId",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "fcmToken",
      "value": "",
      "description": "Token FCM dari browser, atau dummy minimal 100 karakter untuk uji backend."
    },
    {
      "key": "nik",
      "value": "",
      "description": "NIK 16 digit acak, dibuat ulang oleh pre-request 03."
    },
    {
      "key": "today",
      "value": "",
      "description": "Tanggal hari ini (YYYY-MM-DD), diisi oleh pre-request 04."
    },
    {
      "key": "regKey",
      "value": "",
      "description": "Kunci idempotensi registrasi, dipakai 04 dan 04b."
    },
    {
      "key": "payKey",
      "value": "",
      "description": "Kunci idempotensi pembayaran, dipakai 13 dan 13b."
    },
    {
      "key": "amount",
      "value": "",
      "description": "Total invoice asli, diisi oleh test script 12."
    },
    {
      "key": "paymentId",
      "value": "",
      "description": "ID pembayaran pertama, dipakai 13b."
    },
    {
      "key": "partialAmount",
      "value": "",
      "description": "Pembayaran pertama: total dikurangi 15000, diisi test script 12."
    },
    {
      "key": "remainingBefore",
      "value": "",
      "description": "Sisa setelah pembayaran pertama, diisi test script 13."
    },
    {
      "key": "overpayAmount",
      "value": "",
      "description": "Sisa + 15000, dipakai 13c untuk menghasilkan kembalian 15000."
    },
    {
      "key": "payKeyOverpay",
      "value": "",
      "description": "Kunci idempotensi pembayaran lebih, dipakai 13c."
    },
    {
      "key": "nodeUrl",
      "value": "http://127.0.0.1:3010",
      "description": "Base URL layanan Node/Express."
    }
  ],
  "item": [
    {
      "name": "01 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"Admin123!\",\"fcm_token\":\"{{fcmToken}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['token','patientId','registrationId','examId','prescriptionId','labRequestId','invoiceId','regKey','payKey','payKeyOverpay','amount','partialAmount','remainingBefore','overpayAmount','paymentId'].forEach(function (key) { pm.collectionVariables.set(key, ''); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login sukses', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json().data;",
              "pm.collectionVariables.set('token', data.token);",
              "pm.collectionVariables.set('userId', data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Me",
      "request": {
        "method": "GET",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "03 Buat pasien",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Pasien Postman {{nik}}\",\"nik\":\"{{nik}}\",\"gender\":\"P\",\"birth_date\":\"1990-01-01\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var stamp = Date.now().toString();",
              "var suffix = Math.floor(Math.random() * 1000).toString().padStart(3, '0');",
              "pm.collectionVariables.set('nik', (stamp + suffix).slice(-16));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('pasien dibuat', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('patientId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Buat registrasi",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"patient_id\":{{patientId}},\"polyclinic_id\":1,\"doctor_id\":1,\"registration_date\":\"{{today}}\",\"idempotency_key\":\"{{regKey}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/registrations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "registrations"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('today', new Date().toISOString().slice(0, 10));",
              "if (!pm.collectionVariables.get('regKey')) pm.collectionVariables.set('regKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registrasi dibuat', function () { pm.response.to.have.status(200); });",
              "pm.collectionVariables.set('registrationId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04b Registrasi ulang (idempoten)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"patient_id\":{{patientId}},\"polyclinic_id\":1,\"doctor_id\":1,\"registration_date\":\"{{today}}\",\"idempotency_key\":\"{{regKey}}\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/registrations",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "registrations"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('idempotensi registrasi', function () {",
              "  var data = pm.response.json().data;",
              "  pm.expect(data.replayed).to.eql(true);",
              "  pm.expect(data.id).to.eql(Number(pm.collectionVariables.get('registrationId')));",
              "});"
            ]
          }
        }
      ]
    },
