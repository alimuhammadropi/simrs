    {
      "name": "16 Notifikasi - Daftar token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"token\":\"{{fcmToken}}\",\"platform\":\"web\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/notifications/token",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "notifications",
            "token"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.collectionVariables.get('fcmToken')) {",
              "  var token = '';",
              "  while (token.length < 120) token += pm.variables.replaceIn('{{$guid}}').replace(/-/g, '');",
              "  pm.collectionVariables.set('fcmToken', token.slice(0, 120));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('token notifikasi tersimpan', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
